<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Desain MamaCare hanya punya versi terang. -->
    <style name="Base.Theme.Mamacare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/red_purple</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:colorBackground">@color/wallpaper_pink</item>
        <item name="android:windowBackground">@color/wallpaper_pink</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="textInputStyle">@style/Widget.MamaCare.TextField</item>
        <item name="materialButtonStyle">@style/Widget.MamaCare.Button</item>
    </style>

    <style name="Theme.Mamacare" parent="Base.Theme.Mamacare" />
</resources>
