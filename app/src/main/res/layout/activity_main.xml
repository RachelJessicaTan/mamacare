<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wallpaper_pink"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="12dp"
            android:paddingEnd="29dp"
            android:paddingBottom="24dp">

            <!-- Tanggal, sapaan, dan notifikasi -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/today"
                        style="@style/MamaCare.Text.Date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="TUESDAY, OCTOBER 6" />

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/MamaCare.Text.Greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        tools:text="Good morning, Mama Coco!" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/notification_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_bell"
                    android:clickable="true"
                    android:contentDescription="@string/notifications"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bell" />

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginTop="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot_notification" />
                </FrameLayout>
            </FrameLayout>

            <!-- Minggu kehamilan -->
            <LinearLayout
                android:id="@+id/week_card"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="19dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/week_ring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:max="40"
                        app:indicatorColor="@color/red_purple"
                        app:indicatorInset="0dp"
                        app:indicatorSize="50dp"
                        app:trackColor="@color/pink_soft"
                        app:trackThickness="3.5dp" />

                    <TextView
                        android:id="@+id/week_number"
                        style="@style/MamaCare.Text.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        tools:text="18" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/week_title"
                        style="@style/MamaCare.Text.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Week 18 of 40" />

                    <TextView
                        android:id="@+id/week_subtitle"
                        style="@style/MamaCare.Text.SemiBold.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        tools:text="Second trimester  ·  22 weeks to go" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_caret_right" />
            </LinearLayout>

            <!-- Pilihan trimester -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_first"
                    style="@style/MamaCare.Text.Chip"
                    android:layout_width="69dp"
                    android:text="@string/trimester_first" />

                <TextView
                    android:id="@+id/chip_second"
                    style="@style/MamaCare.Text.Chip"
                    android:layout_width="85dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/trimester_second" />

                <TextView
                    android:id="@+id/chip_third"
                    style="@style/MamaCare.Text.Chip"
                    android:layout_width="69dp"
                    android:layout_marginStart="20dp"
                    android:text="@string/trimester_third" />
            </LinearLayout>

            <!-- Bayimu minggu ini -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="279dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_baby_card">

                <TextView
                    style="@style/MamaCare.Text.BabyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22.5dp"
                    android:layout_marginTop="31dp"
                    android:text="@string/baby_label" />

                <TextView
                    style="@style/MamaCare.Text.BabyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22.5dp"
                    android:layout_marginTop="58dp"
                    android:text="@string/baby_title" />

                <TextView
                    style="@style/MamaCare.Text.BabyBody"
                    android:layout_width="255dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22.5dp"
                    android:layout_marginTop="100dp"
                    android:text="@string/baby_body" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="193dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MamaCare.Text.StatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/baby_length_value" />

                        <TextView
                            style="@style/MamaCare.Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/baby_length" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="46dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MamaCare.Text.StatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/baby_weight_value" />

                        <TextView
                            style="@style/MamaCare.Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/baby_weight" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dekorasi "Group 10": diputar 18° dan di-blend overlay (lihat MainActivity) -->
                <FrameLayout
                    android:id="@+id/baby_deco"
                    android:layout_width="124.979dp"
                    android:layout_height="127.164dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="131.8dp"
                    android:layout_marginEnd="15.5dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:rotation="18"
                    android:transformPivotX="62.49dp"
                    android:transformPivotY="59.58dp">

                    <ImageView
                        android:id="@+id/baby_deco_shadow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.25"
                        android:src="@drawable/bg_baby_deco"
                        android:translationY="4dp"
                        app:tint="@color/black"
                        app:tintMode="src_in" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_baby_deco" />
                </FrameLayout>
            </FrameLayout>

            <!-- Untuk hari ini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MamaCare.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/for_you_today" />

                <TextView
                    android:id="@+id/see_all"
                    style="@style/MamaCare.Text.SemiBold.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/see_all"
                    android:textSize="15sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-28dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="-29dp"
                android:clipToPadding="false"
                android:paddingStart="28dp"
                android:paddingEnd="29dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tip_body"
                        android:layout_width="254dp"
                        android:layout_height="185dp"
                        android:background="@drawable/bg_tip_card"
                        android:backgroundTint="@color/tip_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="19dp">

                        <FrameLayout
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_tip_icon">

                            <ImageView
                                android:layout_width="33dp"
                                android:layout_height="33dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_pregnant_woman" />
                        </FrameLayout>

                        <TextView
                            style="@style/MamaCare.Text.TipLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="@string/tip_body_label" />

                        <TextView
                            style="@style/MamaCare.Text.TipTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/tip_body_title" />

                        <TextView
                            style="@style/MamaCare.Text.TipBody"
                            android:layout_width="201dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/tip_body_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tip_daily"
                        android:layout_width="254dp"
                        android:layout_height="185dp"
                        android:layout_marginStart="17dp"
                        android:background="@drawable/bg_tip_card"
                        android:backgroundTint="@color/tip_yellow"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="19dp">

                        <FrameLayout
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_tip_icon">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sun" />
                        </FrameLayout>

                        <TextView
                            style="@style/MamaCare.Text.TipLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="@string/tip_daily_label" />

                        <TextView
                            style="@style/MamaCare.Text.TipTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/tip_daily_title" />

                        <TextView
                            style="@style/MamaCare.Text.TipBody"
                            android:layout_width="201dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/tip_daily_text" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                style="@style/MamaCare.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="@string/how_are_you_feeling" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Navigasi bawah -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/nav_home"
            style="@style/MamaCare.NavItem"
            android:contentDescription="@string/nav_home">

            <FrameLayout
                android:layout_width="75dp"
                android:layout_height="37dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_selected">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_home" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_baby"
            style="@style/MamaCare.NavItem"
            android:contentDescription="@string/nav_baby">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_baby" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_community"
            style="@style/MamaCare.NavItem"
            android:contentDescription="@string/nav_community">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_community" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_profile"
            style="@style/MamaCare.NavItem"
            android:contentDescription="@string/nav_profile">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_profile" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
