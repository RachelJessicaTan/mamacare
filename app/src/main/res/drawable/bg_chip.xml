<?xml version="1.0" encoding="utf-8"?>
<!-- Chip trimester: terpilih berwarna pink, lainnya putih bergaris -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pink_soft" />
            <stroke android:width="1dp" android:color="@color/chip_selected_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
